# ==========================================
# OmniSearch AI - Environment Configuration
# ==========================================

# Required for Full-Stack Server & Google Cloud Run:
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenRouter API Key (for Cloudflare Pages functions/api/chat.js and Express /api/chat):
OPENROUTER_API_KEY=

# Administrative / Seller Panel Security PIN (Required to secure seller panel):
ADMIN_PIN=

# Optional: Client-side Gemini API key for static BYOK (Bring Your Own Key)
VITE_GEMINI_API_KEY=

# Optional: Port for Express server (Defaults to 3000)
PORT=3000

# Optional: Node Environment (development / production)
NODE_ENV=production
