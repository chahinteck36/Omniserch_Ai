# ==========================================
# OmniSearch AI - Environment Configuration
# ==========================================

# Required for Full-Stack Server & Google Cloud Run:
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenRouter API Key (for Cloudflare Pages functions/api/chat.js and Express /api/chat):
OPENROUTER_API_KEY=

# Optional: Client-side Gemini API key for static deployments (GitHub Pages / Firebase Hosting)
VITE_GEMINI_API_KEY=

# Optional: Port for Express server (Defaults to 3000)
PORT=3000

# Optional: Node Environment (development / production)
NODE_ENV=production
