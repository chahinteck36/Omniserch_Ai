# ==============================================================================
# OmniSearch AI - Environment Configuration Guide
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER-SIDE SECRETS (Set in Render, Google Cloud Run, or Docker - NEVER in Frontend)
# ------------------------------------------------------------------------------

# [Required for Server Search Engine] Google Gemini API Key
# Obtains search answers, Google Grounding web sources, code analysis, and deep research.
# Get free API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# [Optional] OpenRouter API Key
# Enables Meta Llama 3, DeepSeek, and other battle mode LLMs on Express (/api/chat) & Cloudflare Functions.
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# [Required for Production Security] Seller / Administrator PIN
# Protects the license code generator and quota reset operations at /api/admin/*
ADMIN_PIN=

# [Recommended for Production] JWT / Token Signing Secret
# Signs user tokens to prevent quota tampering and enforce license validity.
TOKEN_SECRET=

# [Optional] Express Server Port (Render sets this dynamically, default: 3000)
PORT=3000

# [Optional] Node Environment ('development' | 'production')
NODE_ENV=production


# ------------------------------------------------------------------------------
# 2. PERSISTENCE & DATABASE: Cloud SQL / PostgreSQL (Optional - In-Memory Fallback Available)
# ------------------------------------------------------------------------------
# If omitted or not configured, OmniSearch AI automatically falls back to secure
# file/memory storage without crashing the server.
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=


# ------------------------------------------------------------------------------
# 3. FRONTEND PUBLIC VARIABLES (Set in Cloudflare Pages Build Environment)
# ------------------------------------------------------------------------------

# [Critical for Cloudflare Pages + Render Split Deployment]
# URL of the deployed Express backend (e.g. https://omniserch-backend.onrender.com).
# Leave empty if frontend and backend are deployed together in one container/host.
VITE_API_BASE_URL=

# [Optional] Client-side BYOK fallback for pure static deployments without backend
VITE_GEMINI_API_KEY=
